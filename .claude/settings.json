      "Bash(cargo test:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo llvm-cov:*)",
      "Bash(cargo info:*)",
      "Bash(cargo search:*)",
      "Bash(pnpm view:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
